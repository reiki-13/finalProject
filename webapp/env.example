# Copy this file to .env (in the same webapp/ folder) and fill in your real key.
# .env is listed in .gitignore and will never be committed -- .env.example
# (this file) is the only one that should ever be tracked by git.

# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Optional: override the default model. Groq deprecates/renames models
# fairly often -- if you see a "NotFoundError", the current default below
# has likely been retired; check https://console.groq.com/docs/models for
# a current model ID and set it here instead of editing app.py.
# GROQ_MODEL=openai/gpt-oss-120b
